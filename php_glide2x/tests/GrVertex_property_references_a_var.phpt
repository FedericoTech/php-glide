--TEST--
GrVertex property references
--FILE--
<?php
$vertex1 = new GrVertex;
$vertex2 = new GrVertex;

$vertex1->x = 2;
$vertex1->y =& $vertex1->x;
$vertex2->z =& $vertex1->y;

$ref = 3;
$ref =& $vertex2->z;

$vertex3 = clone $vertex2;

$ref = 10;

var_dump($ref);

var_dump($vertex1);
print_r($vertex1);
testGrVertex($vertex1);

var_dump($vertex2);
print_r($vertex2);
testGrVertex($vertex2);

var_dump($vertex3);
print_r($vertex3);
testGrVertex($vertex3);
?>
